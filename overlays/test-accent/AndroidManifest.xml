<?xml version="1.0" encoding="utf-8"?>
<!--
  Test overlay: paints the framework's primary Monet ramp (system_accent1_*)
  bright magenta so it is obvious on screen whether a non-root overlay
  APK can reach framework colors on One UI 9.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.oneuitheme.test.accent"
    android:versionCode="1"
    android:versionName="0.1-test">

    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="35" />

    <overlay
        android:targetPackage="android"
        android:isStatic="false" />

    <application
        android:hasCode="false"
        android:label="One UI Theme test: accent" />
</manifest>
