{
  "$name": "HexNext design tokens",
  "$source": "Extracted from the HexNext dashboard (apps/hex-next/assets/index.html). Dark glass cards, cyan accent, violet secondary.",
  "color": {
    "bg-base":       { "value": "#080A0F", "use": "App ground, status and navigation bars" },
    "bg-surface":    { "value": "#10141E", "use": "Tab bar, panels, dialogs" },
    "bg-card":       { "value": "rgba(22, 28, 42, 0.75)", "use": "Glass cards" },
    "bg-card-hover": { "value": "rgba(30, 38, 58, 0.95)", "use": "Selected or pressed card" },
    "scrim":         { "value": "rgba(8, 10, 15, 0.9)", "use": "Sticky header and bottom bar behind blur" },
    "border-glass":  { "value": "rgba(255, 255, 255, 0.09)", "use": "Card and divider borders" },
    "border-active": { "value": "rgba(0, 229, 255, 0.6)", "use": "Focused field, selected card outline" },
    "accent":        { "value": "#00E5FF", "use": "Active state, primary action" },
    "accent-glow":   { "value": "rgba(0, 229, 255, 0.35)", "use": "Glow under accent fills" },
    "secondary":     { "value": "#7C4DFF", "use": "Gradient partner to the accent" },
    "on-accent":     { "value": "#000000", "use": "Text and icons on an accent fill" },
    "text-main":     { "value": "#FFFFFF", "use": "Primary text" },
    "text-muted":    { "value": "#8E9BAE", "use": "Secondary text, section labels" },
    "text-dim":      { "value": "#546075", "use": "Decorative only, never body text" },
    "success":       { "value": "#00E676", "use": "Applied, connected" },
    "warning":       { "value": "#FFD600", "use": "Caution" },
    "danger":        { "value": "#FF5252", "use": "Destructive, disconnected" }
  },
  "radius": {
    "sm": 8,
    "md": 14,
    "lg": 20,
    "xl": 28,
    "phone": 36,
    "pill": 999
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24,
    "6": 32
  },
  "font": {
    "family-sans": "-apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, \"Helvetica Neue\", Arial, sans-serif",
    "family-mono": "ui-monospace, Menlo, Consolas, monospace"
  },
  "type": {
    "display": { "size": 28, "weight": 800, "tracking": -0.5 },
    "brand":   { "size": 20, "weight": 800, "tracking": -0.5 },
    "section": { "size": 14, "weight": 800, "tracking": 0.6, "uppercase": true },
    "body":    { "size": 14, "weight": 600, "tracking": 0 },
    "control": { "size": 13, "weight": 700, "tracking": 0 },
    "caption": { "size": 11, "weight": 700, "tracking": 0.5, "uppercase": true }
  },
  "elevation": {
    "glow":  { "y": 4,  "blur": 14, "color": "accent-glow" },
    "float": { "y": 20, "blur": 50, "color": "rgba(0, 0, 0, 0.8)" }
  },
  "blur": {
    "glass": 20,
    "card": 12
  }
}
