          "radiusRole": "keyboardKeyRadius"
        }
      }
    },
    "light": {
      "components": {
        "quickTile": {
          "shape": "roundedRectangle",
          "fillRole": "quickTileActive",
          "strokeRole": "outline",
          "strokeWidthDp": 1,
          "radiusRole": "quickTileRadius"
        },
        "keyboardKey": {
          "shape": "roundedRectangle",
